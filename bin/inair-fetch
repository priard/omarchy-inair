#!/usr/bin/bash
# Every byte this plugin pulls off the network comes through here.
#
# The widget runs inside omarchy-shell, one process shared with the whole
# desktop, so nothing unbounded may reach it: each subcommand caps the
# response at the producer (curl --max-filesize plus head -c cap+1), runs
# under an absolute deadline in its own session so no descendant outlives it,
# and prints a small, strictly shaped document on stdout.
#
# Arguments are never spliced into a shell string and never into a URL before
# they have matched an anchored pattern. Everything the callers pass comes
# from InPost's own API, which is to say from the network, which is to say it
# is untrusted.
#
# They also never sit on a command line. Coordinates, a postcode, a locker
# code or the slug of its page all say where somebody lives, and every
# process's argv is readable in /proc by anyone on the machine. So the widget
# passes them on stdin (`inair-fetch nearby` with "LAT LON" on stdin), and
# curl gets its URL from a config on stdin as well. Passing them as arguments
# still works, for running the helper by hand.
#
# Endpoints, all public, all unauthenticated — no credential ever travels here:
#   nearby    GET  api-shipx-pl.easypack24.net/v1/points?relative_point=…
#   postcode  GET  api-shipx-pl.easypack24.net/v1/points?relative_post_code=…
#   point     GET  api-shipx-pl.easypack24.net/v1/points/<code>
#   id      GET  inpost.pl/<locker-page-slug>
#   air     POST inpost.pl/shipx-point-data/<id>/<code>/air_index_level
#   sc-box  GET  data.sensor.community/airrohr/v1/filter/box=S,W,N,E
#   gios-*  GET  api.gios.gov.pl/pjp-api/v1/rest/… (station list, sensors,
#                data, index) — never given a coordinate
#   om-current GET air-quality-api.open-meteo.com/v1/air-quality?…
#   om-weather GET api.open-meteo.com/v1/forecast?… (temperature, humidity,
#                pressure for the Open-Meteo source)
#   geocode GET  geocoding-api.open-meteo.com/v1/search?name=…

set -uo pipefail
LC_ALL=C
export LC_ALL

readonly CURL=/usr/bin/curl
readonly HEAD=/usr/bin/head
readonly TIMEOUT=/usr/bin/timeout
readonly SETSID=/usr/bin/setsid
readonly GREP=/usr/bin/grep
readonly OD=/usr/bin/od

# Point searches ask only for the fields the widget reads, which keeps 300
# points to roughly 115 KB; the locker page is ~80 KB of HTML. The
# caps are generous enough for both to grow and small enough that a hostile or
# broken origin cannot fill the shell's heap.
readonly MAX_POINTS=524288
readonly MAX_PAGE=524288
readonly MAX_AIR=16384
# A 10 km Sensor.Community box in a big city is a few hundred KB of
# five-minute samples; the GIOŚ station list is ~90 KB; everything else is a
# few KB.
readonly MAX_SC=1048576
readonly MAX_LIST=262144
readonly MAX_SMALL=65536

readonly UA='omarchy-inair'

die() {
  printf '%s\n' "inair-fetch: $1" >&2
  exit 1
}

# curl -q first so ~/.curlrc cannot add a second URL or a redirect; no -L, so a
# redirect is a failure rather than a silent hop to somewhere else; --noproxy
# so an environment proxy cannot see or rewrite the traffic.
#
# The URL reaches curl through `-K -`, a config read from stdin, rather than
# as an argument. A config line is a parser boundary, so the URL is held to a
# closed alphabet first: every part of it has already matched an anchored
# pattern, and this check makes sure no quote, backslash, space or newline —
# anything that could end the value or start another directive — got through.
fetch() {
  local url="$1" max="$2"
  shift 2

  [[ $url =~ ^https://[A-Za-z0-9.-]+/[A-Za-z0-9./?=\&,_:%-]*$ ]] || die "refusing URL"

  # For tests: what would be fetched, without fetching it. The widget runs
  # this helper with an emptied environment, so it cannot turn this on.
  if [ "${INAIR_DRY_RUN:-}" = 1 ]; then
    printf '%s\n' "$url"
    return 0
  fi

  local out
  out=$(printf 'url = "%s"\n' "$url" \
        | "$SETSID" -w "$TIMEOUT" -k 2 -- 20 \
          "$CURL" -q -sS --fail \
            --proto '=https' --proto-redir '=https' --noproxy '*' \
            --connect-timeout 5 --max-time 15 --max-filesize "$max" \
            -A "$UA" "$@" -K - \
        | "$HEAD" -c $((max + 1)))
  local rc=$?

  [ "$rc" -eq 0 ] || exit "$rc"
  [ ${#out} -le "$max" ] || die "response exceeded $max bytes"

  printf '%s' "$out"
}

# A coordinate is a number with at most eight decimals. Anything else — an
# empty string, a minus sign on its own, a second dot, a shell metacharacter —
# never reaches the URL.
valid_coord() {
  [[ $1 =~ ^-?[0-9]{1,3}(\.[0-9]{1,8})?$ ]]
}

# Air sensors are sparse outside the cities, so a search looks at the 300
# nearest points rather than ShipX's default 25: that reaches 10 km and more
# from a village, where 100 points covered five. Only the fields the widget
# reads are asked for, which keeps the larger search smaller than the old one.
readonly SEARCH="limit=300&fields=name,air_index_level,distance,location,address,address_details,location_description"

cmd_nearby() {
  local lat="${1:-}" lon="${2:-}"
  valid_coord "$lat" || die "invalid latitude"
  valid_coord "$lon" || die "invalid longitude"

  fetch "https://api-shipx-pl.easypack24.net/v1/points?relative_point=${lat},${lon}&${SEARCH}" \
    "$MAX_POINTS"
}

# The same search from a Polish postcode instead of coordinates, for anyone who
# has no location stored: ShipX sorts by distance from the postcode itself, so
# no geocoder is involved and the postcode goes to InPost alone. NN-NNN or
# NNNNN; it reaches the URL only in the NN-NNN form.
cmd_postcode() {
  local code="${1:-}"
  [[ $code =~ ^([0-9]{2})-?([0-9]{3})$ ]] || die "invalid postcode"
  local normalized="${BASH_REMATCH[1]}-${BASH_REMATCH[2]}"

  fetch "https://api-shipx-pl.easypack24.net/v1/points?relative_post_code=${normalized}&${SEARCH}" \
    "$MAX_POINTS"
}

cmd_point() {
  local code="${1:-}"
  [[ $code =~ ^[A-Za-z0-9_-]{1,32}$ ]] || die "invalid locker code"

  fetch "https://api-shipx-pl.easypack24.net/v1/points/${code}" "$MAX_POINTS"
}

# The locker's numeric id appears exactly once on its public page, in a
# data-shipx-url attribute. The slug is built by the caller from ShipX address
# fields and must arrive already reduced to the closed alphabet below, so no
# path segment, query or scheme can be smuggled in through a street name.
cmd_id() {
  local slug="${1:-}"
  [[ $slug =~ ^paczkomat-[a-z0-9-]{3,180}$ ]] || die "invalid locker page slug"

  local page
  page=$(fetch "https://inpost.pl/${slug}" "$MAX_PAGE") || exit $?

  local match
  match=$(printf '%s' "$page" \
    | "$GREP" -m1 -oE 'data-shipx-url="/shipx-point-data/[0-9]{1,12}/[A-Za-z0-9_-]{1,32}/air_index_level"')
  [ -n "$match" ] || die "no air sensor widget on this locker page"

  # Field-split the matched attribute rather than running a second regex over
  # the whole page: the shape is already fixed by the match above.
  local rest="${match#data-shipx-url=\"/shipx-point-data/}"
  local id="${rest%%/*}"
  rest="${rest#*/}"
  local code="${rest%%/*}"

  printf '{"id":"%s","code":"%s"}\n' "$id" "$code"
}

cmd_air() {
  local id="${1:-}" code="${2:-}"
  [[ $id =~ ^[0-9]{1,12}$ ]] || die "invalid locker id"
  [[ $code =~ ^[A-Za-z0-9_-]{1,32}$ ]] || die "invalid locker code"

  fetch "https://inpost.pl/shipx-point-data/${id}/${code}/air_index_level" "$MAX_AIR" \
    -X POST -H 'X-Requested-With: XMLHttpRequest'
}

readonly GIOS="https://api.gios.gov.pl/pjp-api/v1/rest"

# The four corners arrive already rounded by the widget; each is held to the
# coordinate pattern before it reaches the URL.
cmd_sc_box() {
  [ "$#" -eq 4 ] || die "sc-box needs four coordinates"
  local c
  for c in "$@"; do valid_coord "$c" || die "invalid coordinate"; done
  fetch "https://data.sensor.community/airrohr/v1/filter/box=$1,$2,$3,$4" "$MAX_SC"
}

# GIOŚ is asked for its whole station list and the nearest station is picked
# in the widget, so this source never learns where the user is.
cmd_gios_stations() {
  fetch "${GIOS}/station/findAll?size=500" "$MAX_LIST"
}

valid_id() {
  [[ $1 =~ ^[0-9]{1,9}$ ]]
}

cmd_gios_sensors() {
  valid_id "${1:-}" || die "invalid station id"
  fetch "${GIOS}/station/sensors/$1" "$MAX_SMALL"
}

cmd_gios_data() {
  valid_id "${1:-}" || die "invalid sensor id"
  fetch "${GIOS}/data/getData/$1" "$MAX_SMALL"
}

cmd_gios_index() {
  valid_id "${1:-}" || die "invalid station id"
  fetch "${GIOS}/aqindex/getIndex/$1" "$MAX_SMALL"
}

cmd_om_current() {
  local lat="${1:-}" lon="${2:-}"
  valid_coord "$lat" || die "invalid latitude"
  valid_coord "$lon" || die "invalid longitude"
  fetch "https://air-quality-api.open-meteo.com/v1/air-quality?latitude=${lat}&longitude=${lon}&current=pm10,pm2_5,european_aqi&timezone=auto" \
    "$MAX_SMALL"
}

cmd_om_weather() {
  local lat="${1:-}" lon="${2:-}"
  valid_coord "$lat" || die "invalid latitude"
  valid_coord "$lon" || die "invalid longitude"
  fetch "https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,relative_humidity_2m,surface_pressure&timezone=auto" \
    "$MAX_SMALL"
}

# Every byte that is not an ASCII letter or digit leaves as %XX, so whatever
# was typed — Polish letters, a hyphen, a quote — reaches the URL as the same
# closed alphabet the fetch check enforces. The bytes come from od, not from
# printf's locale-dependent character arithmetic.
urlencode() {
  local hex out="" b
  hex=$(printf '%s' "$1" | "$OD" -An -tx1 -v)
  for b in $hex; do
    case $b in
      3[0-9]|4[1-9a-f]|5[0-9a]|6[1-9a-f]|7[0-9a]) out+=$(printf "\\x$b") ;;
      *) out+="%${b^^}" ;;
    esac
  done
  printf '%s' "$out"
}

# A place name as typed. The words arrive split on spaces and are joined
# back; the length cap is in bytes, generous for any real place name.
cmd_geocode() {
  local name="$*"
  [ -n "$name" ] || die "empty place name"
  [ "${#name}" -le 96 ] || die "place name too long"
  [[ $name =~ [[:cntrl:]] ]] && die "control character in place name"
  fetch "https://geocoding-api.open-meteo.com/v1/search?name=$(urlencode "$name")&count=5&language=pl&format=json" \
    "$MAX_SMALL"
}

# The arguments of a subcommand: from argv when given there (by hand), else
# one line of at most 512 bytes on stdin, split on spaces. Each is validated by
# the subcommand before it is used.
COMMAND="${1:-}"
shift || true
# The station list takes no argument, and there is nothing to wait for.
if [ "$#" -eq 0 ] && [ "$COMMAND" != gios-stations ]; then
  line=""
  IFS= read -r -t 5 -n 512 line || [ -n "$line" ] || die "no arguments on stdin"
  read -r -a ARGS <<<"$line"
  set -- "${ARGS[@]}"
fi

case "$COMMAND" in
  nearby) cmd_nearby "$@" ;;
  postcode) cmd_postcode "$@" ;;
  point)  cmd_point "$@" ;;
  id)     cmd_id "$@" ;;
  air)    cmd_air "$@" ;;
  sc-box) cmd_sc_box "$@" ;;
  gios-stations) cmd_gios_stations ;;
  gios-sensors) cmd_gios_sensors "$@" ;;
  gios-data) cmd_gios_data "$@" ;;
  gios-index) cmd_gios_index "$@" ;;
  om-current) cmd_om_current "$@" ;;
  om-weather) cmd_om_weather "$@" ;;
  geocode) cmd_geocode "$@" ;;
  *)      die "usage: inair-fetch nearby|postcode|point|id|air|sc-box|gios-stations|gios-sensors|gios-data|gios-index|om-current|om-weather|geocode, arguments on stdin" ;;
esac
