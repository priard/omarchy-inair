#!/usr/bin/python3 -I
"""Keep the PM2.5 trend across shell restarts, and nothing else.

One small file, ~/.local/state/priard.inair/history.json, owned by this plugin:
the readings of the last 24 hours for each of the few lockers used most
recently, so a restart after an update does not wipe the trend, and a look at
another locker does not wipe the one you came back to. Locker codes name
places, so the file is private (0600 in a 0700 directory) from the moment it
is created, and a code never travels on the command line: both commands take
their input on stdin.

    inair-history read     stdin: a locker code. Prints {"code", "samples"}
                           for that locker, or {} if nothing is stored.
    inair-history write    stdin: {"code", "samples"} for one locker. Merged
                           into the file; the other lockers are kept.

On disk: {"version": 2, "lockers": {CODE: [[at, pm25, pm10, temperature,
humidity, pressure], ...]}}, at most MAX_LOCKERS of them, the least recently
read one dropped first. A version 1 file (one locker) is taken over as is.

Both directions go through the same schema check, and what is stored is
re-serialized from the parsed values, never the bytes that arrived. Paths are
walked from the passwd home with held descriptors; the file is read through
one O_NOFOLLOW|O_NONBLOCK descriptor validated with fstat, and written as a
fresh exclusive temporary renamed over the old one, so a symlink, FIFO or
oversized file planted on the name is refused rather than followed.
"""

import json
import math
import os
import pwd
import re
import secrets
import signal
import stat
import sys
import time

STATE_PARTS = (".local", "state", "priard.inair")
STATE_FILE = "history.json"
MAX_BYTES = 262144          # the file: a few lockers' worth of compact samples
MAX_INPUT = 65536           # one locker's samples as the shell sends them
MAX_SAMPLES = 320
MAX_LOCKERS = 4
MAX_AGE_MS = 24 * 3600 * 1000
FIELDS = ("pm25", "pm10", "temperature", "humidity", "pressure")
CODE = re.compile(r"[A-Za-z0-9_-]{1,32}")
DEADLINE_SECONDS = 10


def open_state_dir(create):
    """The plugin's own directory, reached one held descriptor at a time.

    $HOME is only an environment variable; the passwd entry is the anchor. The
    home itself may legitimately be a symlink, so only the components below it
    are opened O_NOFOLLOW, and each must be a real directory this user owns.
    The leaf is the plugin's own and is kept at 0700.
    """
    home = pwd.getpwuid(os.geteuid()).pw_dir
    fd = os.open(home, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        for index, name in enumerate(STATE_PARTS):
            flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
            try:
                nfd = os.open(name, flags, dir_fd=fd)
            except FileNotFoundError:
                if not create:
                    raise
                try:
                    os.mkdir(name, 0o700, dir_fd=fd)
                except FileExistsError:
                    pass
                nfd = os.open(name, flags, dir_fd=fd)
            os.close(fd)
            fd = nfd
            st = os.fstat(fd)
            if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.geteuid():
                raise PermissionError("untrusted directory component: " + name)
            if index == len(STATE_PARTS) - 1 and st.st_mode & 0o077:
                os.fchmod(fd, 0o700)
        return fd
    except BaseException:
        os.close(fd)
        raise


def read_bounded(dirfd):
    try:
        fd = os.open(
            STATE_FILE,
            os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC,
            dir_fd=dirfd,
        )
    except FileNotFoundError:
        return None
    try:
        st = os.fstat(fd)
        if (not stat.S_ISREG(st.st_mode) or st.st_uid != os.geteuid()
                or st.st_nlink != 1 or st.st_mode & 0o077 or st.st_size > MAX_BYTES):
            raise PermissionError("refusing history file (expected a private regular file)")
        os.set_blocking(fd, True)
        data = b""
        while len(data) <= MAX_BYTES:
            chunk = os.read(fd, min(65536, MAX_BYTES + 1 - len(data)))
            if not chunk:
                break
            data += chunk
        if len(data) > MAX_BYTES:
            raise PermissionError("history file grew past %d bytes" % MAX_BYTES)
        return data
    finally:
        os.close(fd)


def write_atomic(dirfd, data):
    if len(data) > MAX_BYTES:
        raise ValueError("history larger than %d bytes" % MAX_BYTES)
    tmp = ".%s.%s.tmp" % (STATE_FILE, secrets.token_hex(8))
    fd = os.open(
        tmp,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
        0o600,
        dir_fd=dirfd,
    )
    try:
        os.fchmod(fd, 0o600)
        view = memoryview(data)
        while view:
            written = os.write(fd, view)
            view = view[written:]
        os.fsync(fd)
        os.rename(tmp, STATE_FILE, src_dir_fd=dirfd, dst_dir_fd=dirfd)
        os.fsync(dirfd)
    except BaseException:
        try:
            os.unlink(tmp, dir_fd=dirfd)
        except OSError:
            pass
        raise
    finally:
        os.close(fd)


def finite(value, low, high):
    """A number within a sane physical range, or None. Booleans are not numbers."""
    if value is None or isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    number = float(value)
    if not math.isfinite(number) or not low <= number <= high:
        return None
    return round(number, 2)


RANGES = {
    "pm25": (0, 5000),
    "pm10": (0, 5000),
    "temperature": (-80, 80),
    "humidity": (0, 100),
    "pressure": (500, 1200),
}


def clean_samples(samples, now):
    """Rebuild a list of samples out of what survives the schema.

    Accepts the shell's objects ({"at", "pm25", ...}) and the file's compact
    rows ([at, pm25, ...]) alike. A sample with a bad timestamp is dropped, a
    field out of range becomes null, and samples older than a day or from the
    future go. At most MAX_SAMPLES are kept, newest last.
    """
    if not isinstance(samples, list):
        return []
    out = []
    for item in samples[: MAX_SAMPLES * 2]:
        if isinstance(item, dict):
            at = item.get("at")
            values = [item.get(field) for field in FIELDS]
        elif isinstance(item, list) and len(item) == len(FIELDS) + 1:
            at = item[0]
            values = item[1:]
        else:
            continue
        if isinstance(at, bool) or not isinstance(at, int):
            continue
        if not now - MAX_AGE_MS <= at <= now + 60000:
            continue
        row = [at]
        for field, value in zip(FIELDS, values):
            low, high = RANGES[field]
            row.append(finite(value, low, high))
        out.append(row)
    out.sort(key=lambda r: r[0])
    return out[-MAX_SAMPLES:]


def valid_code(code):
    return isinstance(code, str) and CODE.fullmatch(code) is not None


def clean_store(document, now):
    """The stored lockers, as {code: rows}, from a version 1 or 2 document."""
    lockers = {}
    if not isinstance(document, dict):
        return lockers
    if document.get("version") == 1 or "code" in document:
        if valid_code(document.get("code")):
            lockers[document["code"]] = clean_samples(document.get("samples"), now)
    else:
        stored = document.get("lockers")
        if isinstance(stored, dict):
            for code in list(stored)[: MAX_LOCKERS * 4]:
                if valid_code(code):
                    lockers[code] = clean_samples(stored[code], now)
    return {code: rows for code, rows in lockers.items() if rows}


def newest_first(lockers):
    return sorted(lockers, key=lambda code: lockers[code][-1][0], reverse=True)


def as_objects(rows):
    return [dict(zip(("at",) + FIELDS, row)) for row in rows]


def encode(document):
    return json.dumps(document, separators=(",", ":"), allow_nan=False).encode("utf-8")


def read_stdin(limit):
    data = sys.stdin.buffer.read(limit + 1)
    if len(data) > limit:
        raise ValueError("input larger than %d bytes" % limit)
    return data.decode("utf-8", "strict")


def load_store(dirfd, now):
    raw = read_bounded(dirfd)
    if raw is None:
        return {}
    return clean_store(json.loads(raw.decode("utf-8", "strict")), now)


def cmd_read():
    code = read_stdin(64).strip()
    if not valid_code(code):
        raise ValueError("invalid locker code")
    try:
        dirfd = open_state_dir(create=False)
    except FileNotFoundError:
        sys.stdout.write("{}")
        return 0
    try:
        lockers = load_store(dirfd, int(time.time() * 1000))
    finally:
        os.close(dirfd)
    if code not in lockers:
        sys.stdout.write("{}")
        return 0
    sys.stdout.write(encode({"version": 2, "code": code,
                             "samples": as_objects(lockers[code])}).decode("utf-8"))
    return 0


def cmd_write():
    document = json.loads(read_stdin(MAX_INPUT))
    if not isinstance(document, dict) or not valid_code(document.get("code")):
        raise ValueError("input does not match the history schema")
    now = int(time.time() * 1000)
    rows = clean_samples(document.get("samples"), now)

    dirfd = open_state_dir(create=True)
    try:
        # Read, merge, write. Two shells writing at once can lose one of the
        # two updates; each carries the full history of its locker, so the
        # next write restores it. The file itself is never torn.
        try:
            lockers = load_store(dirfd, now)
        except (PermissionError, ValueError) as exc:
            # A refused or corrupt file is not overwritten silently into
            # something else; say why and leave it alone.
            raise ValueError("existing history refused: %s" % exc)
        if rows:
            lockers[document["code"]] = rows
        else:
            lockers.pop(document["code"], None)
        keep = newest_first(lockers)[:MAX_LOCKERS]
        out = {"version": 2, "lockers": {code: lockers[code] for code in keep}}
        data = encode(out)
        # Should a day of four lockers ever outgrow the cap, drop the oldest
        # locker rather than fail every write from then on.
        while len(data) > MAX_BYTES and len(keep) > 1:
            keep = keep[:-1]
            out = {"version": 2, "lockers": {code: lockers[code] for code in keep}}
            data = encode(out)
        write_atomic(dirfd, data)
    finally:
        os.close(dirfd)
    return 0


def main():
    # Run from the shell, which waits on stdin and stdout: an absolute deadline
    # keeps a stalled pipe from holding this helper forever.
    signal.alarm(DEADLINE_SECONDS)
    command = sys.argv[1] if len(sys.argv) == 2 else ""
    if command == "read":
        return cmd_read()
    if command == "write":
        return cmd_write()
    sys.stderr.write("usage: inair-history read | write   (input on stdin)\n")
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as exc:  # noqa: BLE001 - one short line, never a traceback
        sys.stderr.write("inair-history: %s\n" % str(exc)[:200])
        sys.exit(1)
